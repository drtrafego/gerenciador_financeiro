# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# API do agente externo (app/api/agent/v1/**), autenticação Bearer.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=***
# Opcional: chave anterior, aceita em paralelo com AGENT_API_KEY durante a rotação
# (defina AGENT_API_KEY_PREVIOUS = valor antigo de AGENT_API_KEY, gere uma nova
# AGENT_API_KEY, faça o deploy, atualize o agente externo e só então remova a antiga).
AGENT_API_KEY_PREVIOUS=***
# Opcional: limite de chamadas por minuto por actor (x-agent-actor). Padrão: 60.
AGENT_RATE_LIMIT_PER_MINUTE=60
# IPs autorizados a chamar a API do agente (app/api/agent/v1/**) e os callbacks
# do WhatsApp (/api/wpp/disconnected e /api/wpp/reconnected). CSV, sem espaços.
# Se não definida, vale a lista embutida no código (o IP do VPS).
# Para DESLIGAR a camada de IP de propósito, use exatamente: TRUSTED_IPS=*
# Apagar a variável NÃO desliga a checagem, só volta para a lista embutida.
# Em pnpm dev a checagem é ignorada automaticamente.
TRUSTED_IPS=31.97.21.249